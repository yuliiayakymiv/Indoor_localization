  command = C:\Windows\system32\cmd.exe /C "$PRE_LINK && ccache C:\ncs\toolchains\5f5ef0cea0\opt\bin\cmake.exe -E rm -f $TARGET_FILE && ccache C:\ncs\toolchains\5f5ef0cea0\opt\zephyr-sdk\gnu\arm-zephyr-eabi\bin\arm-zephyr-eabi-ar.exe qc $TARGET_FILE $LINK_FLAGS @$RSP_FILE && ccache C:\ncs\toolchains\5f5ef0cea0\opt\zephyr-sdk\gnu\arm-zephyr-eabi\bin\arm-zephyr-eabi-ranlib.exe $TARGET_FILE && $POST_BUILD"
