menu "Channel Sounding RAS Initiator sample"

choice SAMPLE_RAS_INITIATOR_STEP_MODE
	prompt "Channel Sounding Step Modes selection"
	default SAMPLE_RAS_INITIATOR_STEP_MODE_2_SUB_MODE_1

config SAMPLE_RAS_INITIATOR_STEP_MODE_2_SUB_MODE_1
	bool "Main: 2, Sub: 1."
	help
	  This option enables CS with main mode 2 and submode 1.
	  Mode 2 steps are used for PBR and mode 1 steps are used for RTT.

config SAMPLE_RAS_INITIATOR_STEP_MODE_1
	bool "Main: 1, Sub: unused."
	help
	  This option enables CS with main mode 1 and submode unused.
	  Mode 1 steps are used for RTT.

config SAMPLE_RAS_INITIATOR_STEP_MODE_2
	bool "Main: 2, Sub: unused."
	help
	  This option enables CS with main mode 2 and submode unused.
	  Mode 2 steps are used for PBR.

config SAMPLE_RAS_INITIATOR_STEP_MODE_3
	bool "Main: 3, Sub: unused."
	select BT_RAS_MODE_3_SUPPORTED
	select BT_CTLR_SDC_CS_STEP_MODE3
	help
	  This option enables CS with main mode 3 and submode unused.
	  Mode 3 steps are used for PBR and RTT.

endchoice

endmenu

menu "Indoor localization"

config IL_NUM_BEACONS
	int "Number of beacons (reflectors named IL_B1..IL_B<n>)"
	default 3
	range 1 4

config IL_BEACON_ID
	int "Role of this board: 0 = mobile node, 1..4 = beacon IL_B<id>"
	default 0
	range 0 4
	help
	  0 builds the mobile node (drone). 1..4 builds a beacon: at boot it measures the
	  distance to every beacon with a higher id, then advertises as IL_B<id> (with the
	  measured distances) and answers the mobile node as a CS reflector.
	  A beacon build also needs -DEXTRA_CONF_FILE=beacon.conf.

config IL_AUTO_LAYOUT
	bool "Build the coordinate plane from the distances measured by the beacons"
	default y
	help
	  y: the mobile node waits until the beacons have measured the distances between
	  each other and builds the coordinate plane from them.
	  n: the distances are the BEACON_Dxx_MM constants in src/main.c.

config IL_EXTERNAL_ANTENNA
	bool "Use the external antenna (U.FL connector) instead of the onboard one"
	default y
	select GPIO
	help
	  y: the XIAO RF switch (P2.05) selects the U.FL connector, the FPC antenna must be
	  plugged in. n: the onboard ceramic antenna. See src/antenna.c.
	  The distance calibration in src/main.c was fitted with onboard antennas.

config IL_SLEEP_BUTTON
	bool "Sleep button on D0 (to GND): press to sleep, press again to wake up"
	default y
	select GPIO
	select POWEROFF
	help
	  See src/sleep_button.c. The pin is set in boards/xiao_nrf54l15_nrf54l15_cpuapp.overlay.
	  Without a button the pin is only pulled up and nothing happens.

config IL_RAW_OUTPUT
	bool "Print a $RAW line with the uncalibrated distance estimates (for calibration)"
	default n

config IL_SAMPLES_PER_TURN
	int "CS distance estimates to collect from a beacon before switching to the next one"
	default 3
	range 1 10

config IL_TURN_TIMEOUT_MS
	int "Maximum time spent on one beacon per turn (ms)"
	default 1500

endmenu

source "Kconfig.zephyr"
